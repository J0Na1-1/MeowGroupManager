TELEGRAM_BOT_TOKEN=replace-with-botfather-token
DATABASE_URL=postgresql+asyncpg://bot:change-me@postgres:5432/tg_guard
TOKEN_SECRET=replace-with-at-least-32-random-bytes
CONFIG_ENCRYPTION_KEY=replace-with-fernet-key
ADMIN_USER_IDS=123456789
GROUP_ID=-1001234567890
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=Asia/Hong_Kong
DEFAULT_CLEANUP_HOUR=9
DEFAULT_CLEANUP_MINUTE=0
DRY_RUN=true
AUTO_REMOVE_ENABLED=false
TOKEN_EXPIRE_MINUTES=30
MMWX_QUERY_TIMEOUT_SECONDS=15
SSH_CONNECT_TIMEOUT_SECONDS=15
POSTGRES_USER=bot
POSTGRES_DB=tg_guard
POSTGRES_PASSWORD=change-me

